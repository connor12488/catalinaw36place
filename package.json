{
  "name": "catalinaw36place",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "agent"
  ],
  "scripts": {
    "dev": "npm --workspace agent run dev",
    "dev:vercel": "npm --prefix apps/vercel-dashboard run dev",
    "build": "npm --workspace agent run build",
    "build:vercel": "npm --prefix apps/vercel-dashboard run build",
    "start": "npm --workspace agent run start",
    "start:vercel": "npm --prefix apps/vercel-dashboard run start",
    "test": "npm --workspace agent run test",
    "test:vercel": "npm --prefix apps/vercel-dashboard run test",
    "typecheck": "npm --workspace agent run typecheck",
    "db:qa:populate": "python3 scripts/populate_qa_entries.py",
    "db:qa:populate:overwrite": "python3 scripts/populate_qa_entries.py --overwrite",
    "db:qa:populate:dry-run": "python3 scripts/populate_qa_entries.py --dry-run"
  },
  "engines": {
    "node": ">=20"
  }
}
