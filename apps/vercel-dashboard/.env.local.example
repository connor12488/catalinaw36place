# Switch Q&A source:
#   db   = read active Q&A from Postgres and enable dashboard CRUD
#   yaml = read qa/rental-qa.yaml and show read-only dashboard
QA_SOURCE=db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Vercel AI Gateway API key.
AI_GATEWAY_API_KEY=replace-with-vercel-ai-gateway-key
AI_MODEL=openai/gpt-5-mini

# Admin dashboard login. Generate this with:
# npm run hash-password -- "your admin password"
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$replace-salt$replace-hash
SESSION_SECRET=replace-with-long-random-secret

# Comma-separated list is supported. Use * only for short local testing.
ALLOWED_ORIGIN=https://www.catalinaw36place.com

# Optional fallback contact shown when no approved answer exists.
PROPERTY_CONTACT_EMAIL=Catalina.w36thPlace@gmail.com
PROPERTY_CONTACT_PHONE=(213)-222-8057

# YAML source used when QA_SOURCE=yaml. Build sync copies the root YAML here.
QA_FILE_PATH=qa/rental-qa.yaml
