# Copy this file to .env.local, or run:
# vercel env pull .env.local
# Empty commit 1
# Required: provide one Postgres connection string from Vercel/Supabase.
# Common names are POSTGRES_URL, DATABASE_URL, or POSTGRES_URL_NON_POOLING.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: override the table created by scripts/create_simple_table.py.
SAMPLE_TABLE_NAME=tenant_qa_smoke_test

